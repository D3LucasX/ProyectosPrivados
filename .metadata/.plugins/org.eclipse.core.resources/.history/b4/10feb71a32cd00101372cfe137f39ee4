package service;

import java.sql.SQLException;
import java.util.ArrayList;

import DAO.StockDAO;
import model.Juguete;
import model.Stand;
import model.Stock;
import model.Zona;

public class StockService {
	private StockDAO dao;
	
	public StockService () {
		this.dao = new StockDAO();
	}
	
	private ArrayList<Stock> crearStocksIniciales(){
		    ArrayList<Stock> seed = new ArrayList<>();

		    // Stand 1 - Pelotas (Zona 1)
		    seed.add(new Stock(new Stand(1), new Zona(1), new Juguete(1), 10)); // Pelota
		    seed.add(new Stock(new Stand(1), new Zona(1), new Juguete(6), 4));  // Balón de fútbol

		    // Stand 2 - Muñecas (Zona 1)
		    seed.add(new Stock(new Stand(2), new Zona(1), new Juguete(2), 5));  // Muñeca

		    // Stand 3 - Construcción (Zona 2)
		    seed.add(new Stock(new Stand(3), new Zona(2), new Juguete(5), 6));  // Lego

		    // Stand 4 - Juegos de Mesa (Zona 2)
		    seed.add(new Stock(new Stand(4), new Zona(2), new Juguete(3), 7));  // Rompecabezas
		    seed.add(new Stock(new Stand(4), new Zona(2), new Juguete(9), 5));  // Ajedrez

		    // Stand 5 - Peluches (Zona 3)
		    seed.add(new Stock(new Stand(5), new Zona(3), new Juguete(8), 8));  // Peluche

		    // Stand 6 - Coches y Trenes (Zona 3)
		    seed.add(new Stock(new Stand(6), new Zona(3), new Juguete(7), 2));  // Coche de carreras
		    seed.add(new Stock(new Stand(6), new Zona(3), new Juguete(4), 3));  // Tren de madera
		    seed.add(new Stock(new Stand(6), new Zona(3), new Juguete(10), 3)); // Pista de autos

		    return seed;
	}
	
	public void insertarStocksIniciales() {
		int filas = 0;
		try {
			if (dao.listarTodos().isEmpty()) {
				ArrayList<Stock> lista = crearStocksIniciales();
				filas = dao.insertarVariosStocks(lista);
				if (filas > 0) {
					System.out.println("Zonas iniciales registradas correctamente.");
				}
			}
		}catch(SQLException e) {
			System.err.println("ERROR al registrar los stocks iniciales.");
			e.printStackTrace();
		}
	}
	
	public boolean insertarStock(Stock stockAinsertar) {
		int filas = 0;
		try {
			filas = dao.registrarStock(stockAinsertar);
			if (filas > 0) {
				return true;
			}
		}catch(SQLException e) {
			e.printStackTrace();
		}
		return false;
	}
	
	public Stock seleccionarStockVenta(Juguete jugueteVenta) throws SQLException {
		Stock stockVenta = dao.seleccionarStockDeJuguete(jugueteVenta);
		return stockVenta;
	}
	
	public boolean modificarStock(Juguete juguete, String sumar_restar) throws SQLException {
		int filas = 0;
		if (sumar_restar.equalsIgnoreCase("sumar")) {
			filas = dao.modificarStock(juguete, "UPDATE stock SET CANTIDAD = CANTIDAD +1 WHERE JUGUETE_idJuguete = " + juguete.getIdJuguete());
			if(filas > 0) {
				System.out.println("Stock aumentado correctamente.");
				return true;
			}else {
				System.err.println("El stock no se ha modificado, algo salió mal.");
				return false;
			}
		}else if (sumar_restar.equalsIgnoreCase("restar")) {
			filas = dao.modificarStock(juguete, "UPDATE stock SET CANTIDAD = CANTIDAD -1 WHERE JUGUETE_idJuguete = " + juguete.getIdJuguete());
			if(filas > 0) {
				System.out.println("Stock decrementado correctamente.");
				return true;
			}else {
				System.err.println("El stock no se ha modificado, algo salió mal.");
				return false;
			}
		}else {
			System.err.println("Error, algo ha ocurrido al modificar el stock del juguete con id "+ juguete.getIdJuguete());
		}
		return false;
	}
}
