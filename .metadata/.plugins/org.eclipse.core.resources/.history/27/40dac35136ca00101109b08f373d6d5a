package DAO;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;

import DataBase.DataBaseConnection;
import model.Zona;

public class ZonaDAO {

	// FUNCION QUE OBTIENE EL SIGUIENTE ID PARA UNA ZONA NUEVA
	public int obtenerSiguienteNumZona() throws SQLException {
		String sql = "SELECT MAX(id) + 1 FROM zona";
		try (Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)) {
			if (rs.next()) {
				return rs.getInt(1);
			}
		}
		return 0;
	}

	// FUNCION QUE REGISTRA UNA NUEVA ZONA
	public int registrarZona(Zona nuevaZona) throws SQLException {
		int filas = 0;
		int idZonaObtenida = obtenerSiguienteNumZona();
		String sql = "INSERT INTO zona (idZona, Nombre, Descripcion) VALUES(?,?,?)";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql)) {
			ps.setInt(1, idZonaObtenida);
			ps.setString(2, nuevaZona.getNombre());
			ps.setString(3, nuevaZona.getDescripcion());

			filas = ps.executeUpdate();
		}
		return filas;
	}

	// FUNCION PARA REGISTRAR VARIAS ZONAS DE SEED DATA SI LA BBDD ESTÁ VACÍA
	public int RegistrarVariasZonas(ArrayList<Zona> seedDataZonas) throws SQLException {
		int zonasInsertadas = 0;
		for (Zona zona : seedDataZonas) {
			zonasInsertadas += registrarZona(zona);
		}
		return zonasInsertadas;
	}

	// FUNCION QUE LISTA LAS ZONAS Y LAS METE EN UNA LISTA
	public ArrayList<Zona> listarTodos() throws SQLException {
		ArrayList<Zona> lista = new ArrayList<>();
		String sql = "SELECT * FROM zona";
		try (Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)) {
			while (rs.next()) {
				lista.add(new Zona(rs.getInt("idZona"), rs.getString("Nombre"), rs.getString("Descripcion")));
			}
		}
		return lista;
	}

	public void listarZonas(boolean habilitada) throws SQLException {
		String sql = "SELECT * from zona where habilitada = ?";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql)) {
			ps.setBoolean(1, habilitada);
			try (ResultSet rs = ps.executeQuery(sql)) {
				while (rs.next()) {
					int idZona = rs.getInt("idZona");
					String nombre = rs.getString("Nombre");
					String descripcion = rs.getString("Descripcion");
					boolean esHabilitada = rs.getBoolean("habilitada");

					System.out.println("ID: " + idZona + ", Nombre: " + nombre + ", Descripción: " + descripcion
							+ ", Habilitada: " + habilitada);
				}
			}
		}
	}
}
