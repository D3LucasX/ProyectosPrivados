	}
	
	// FUNCION QUE LISTA TODAS LAS VENTAS REALIZADAS EN UN MES DETERMINADO DEL AÑO ACTUAL
	public boolean listarVentasEnRealizadasEnUnMes(int mes) throws SQLException {
		String sql = "SELECT *\r\n"
				+ "FROM venta\r\n"
				+ "WHERE YEAR(fecha) = YEAR(CURDATE())\r\n"
				+ "  AND MONTH(fecha)= ?";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql)) {
			ps.setInt(1, mes);
			ResultSet rs = ps.executeQuery();
			if (!rs.next()) {
				System.err.println("No se realizaron ventas ese mes.");
				return false;
			}
			do {
				System.out.printf("ID venta: %d\n"
						+ "Monto: %f\n"
						+ "ID Stand: %d\n"
						+ "ID Zona: %d\n"
						+ "ID Producto: %d\n"
						+ "------------------\n", rs.getInt("idventa"), rs.getDouble("Monto"), rs.getInt("stock_STAND_idStand"),
						rs.getInt("stock_STAND_ZONA_idzona"), rs.getInt("stock_JUGUETE_idJuguete"));
			}while(rs.next());
		}
		return true;
	}
	
	// FUNCION QUE LISTA TODAS LAS VENTAS REALIZADAS EN UN MES DETERMINADO DEL AÑO ACTUAL
	// POR UN EMPLEADO
	public boolean listarVentasEnRealizadasEnUnMesPorEmpleado(int mes, int idEmpleado) throws SQLException {
		String sql = "SELECT idVenta, Fecha, Monto, tipo_pago, stock_STAND_idStand, stock_STAND_ZONA_idzona, stock_JUGUETE_idJuguete, idEMPLEADO, Nombre FROM venta v\r\n"
				+ "inner join\r\n"
				+ "(SELECT idEMPLEADO, Nombre from empleado)t1\r\n"
				+ "on v.EMPLEADO_idEMPLEADO = t1.idEMPLEADO\r\n"
				+ "WHERE YEAR(fecha) = YEAR(CURDATE())\r\n"
				+ "  AND MONTH(fecha)= ? AND\r\n"
				+ "  EMPLEADO_idEMPLEADO = ?";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql)) {
			ps.setInt(1, mes);
			ps.setInt(2, idEmpleado);
			ResultSet rs = ps.executeQuery();
			if (!rs.next()) {
				System.err.printf("No hay registros de ventas del empleado con ID %d en el mes indicado.", idEmpleado);
				return false;
			}
			do {
				System.out.printf("ID venta: %d\n"
						+ "Monto: %f\n"
						+ "ID Stand: %d\n"
						+ "ID Zona: %d\n"
						+ "ID Producto: %d\n"
						+ "ID Empleado: %d\n"
						+ "Nombre del Empleado: %s\n"
						+ "-----------------------------\n", rs.getInt("idventa"), rs.getDouble("Monto"), rs.getInt("stock_STAND_idStand"),
						rs.getInt("stock_STAND_ZONA_idzona"), rs.getInt("stock_JUGUETE_idJuguete"));
			}while(rs.next());
		}
		return true;
	}
	
	//FUNCION QUE OBTIENE LOS DATOS DE UN CAMBIO CON EL EMPLEADO RESPONSABLE Y EL MOTIVO DEL CAMBIO
	public boolean listarCambios() throws SQLException {
		String sql = "select idCAMBIO, MOTIVO, idEMPLEADO, Nombre empleadoResponsable, Fecha from cambio c\r\n"
				+ "inner Join\r\n"
				+ "(SELECT idEMPLEADO, Nombre from empleado)t1\r\n"
				+ "on c.EMPLEADO_idEMPLEADO = t1.idEMPLEADO";
		try(Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)){
			if(!rs.next()) {
				System.err.println("No hay compras registradas.");
				return false;
			}
			do {
				System.out.printf("ID del cambio: %d\n"
						+ "Motivo: %s\n"
						+ "Empleado responsable: %d\n"
						+ "Nombre del empleado: %s\n"
						+ "Fecha del cambio: %s\n"
						+ "--------------------------------\n", rs.getInt("idCAMBIO"), rs.getString("MOTIVO"), rs.getInt("idEMPLEADO"), rs.getString("empleadoResponsable"), rs.getDate("Fecha"));
			}while(rs.next());
		}
		return true;
	}
	
	
}
