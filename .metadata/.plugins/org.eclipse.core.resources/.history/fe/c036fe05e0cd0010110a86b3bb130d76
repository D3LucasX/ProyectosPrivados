package DAO;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

import DataBase.DataBaseConnection;

public class StatsDAO {

	// FUNCION QUE MUESTRA LOS 5 PRODUCTOS MAS VENDIDOS
	public boolean masVendidosCinco () throws SQLException {
		String sql = "select stock_JUGUETE_idJuguete, Nombre, count(*) as veces_vendido from venta \r\n"
				+ "inner join\r\n"
				+ "(SELECT idJuguete, Nombre from juguete)t1\r\n"
				+ "on venta.stock_JUGUETE_idJuguete = t1.idJuguete\r\n"
				+ "group by stock_JUGUETE_idJuguete, Nombre\r\n"
				+ "order by veces_vendido desc\r\n"
				+ "limit 5;";
		try(Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)){
			if(!rs.next()) {
				System.err.println("No hay compras registradas.");
				return false;
			}
			int i = 1;
			do{
				System.out.printf("Producto en %dº posición"
						+ "-------------------------"
						+ "ID producto: %d\\n"
						+ "Nombre producto: %s\n"
						+ "Veces vendido: %d", i ,rs.getInt("stock_JUGUETE_idJuguete"), rs.getString("Nombre"), rs.getInt("veces_vendido"));
				System.out.println();
				i++;
			}while (rs.next());
		}
		return true;
	}
	
	// FUNCION QUE MUESTRA LOS EMPLEADOS QUE MAS VENTAS HAN REALIZADO
	public boolean empleadosMasVentas() throws SQLException {
		String sql = "select EMPLEADO_idEMPLEADO, Nombre, count(*) as mas_ventas from venta \r\n"
				+ "inner join\r\n"
				+ "(SELECT idEMPLEADO, Nombre from empleado)t1\r\n"
				+ "on venta.EMPLEADO_idEMPLEADO = t1.idEMPLEADO\r\n"
				+ "group by  EMPLEADO_idEMPLEADO, Nombre\r\n"
				+ "order by mas_ventas desc\r\n"
				+ "limit 5;";
		try(Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)){
			if(!rs.next()) {
				System.err.println("No hay compras registradas.");
				return false;
			}
			int i = 1;
			do{
				System.out.printf("Empleado en %dº posición"
						+ "-------------------------"
						+ "ID Empleado: %d\\n"
						+ "Nombre Empleado: %s\n"
