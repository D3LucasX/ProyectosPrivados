package DAO;

import java.sql.Connection;
import java.sql.Date;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

import DataBase.DataBaseConnection;
import model.Cambio;
import model.Empleado;
import model.Juguete;
import model.Stand;
import model.Venta;
import model.Zona;

public class VentasDAO {

	// LISTAR LOS JUGUETES ACTIVOS EN LA CLASE JUGUETEDAO
	// SELECCIONAR JUGUETE ACTIVO POR ID EN JUGUETEDAO --> DEVUELVE EL JUGUETE CON
	// EL ID Y EL PRECIO
	// FUNCION DE SELECCIONAR EL STOCK PARA COGER EL IDZONA Y EL IDSTAND EN STOCKDAO
	// FUNCION PARA MODIFICAR EL CAMPO CANTIDAD EN STOCK EN STOCK DAO Y STOCK
	// SERVICE

	/**
	 * ID VENTA --> AUTOINCREMENTAL DATE FECHA VENTA --> NOW() MONTO TOTAL -->
	 * ACCEDER AL PRECIO DEL JUGUETE PAGO --> SE SETEA EN LA FUNCION DE GESTÓN VENTA
	 * JUGUETE, EL QUE SE LE PASA EMPLEADO EL QUE SE LE PASA STAND, EL QUE SE CREA
	 * CON EL ID STAND QUE SACAMOS DEL STOCK QUE SE OBTIENE DE LA FUNCION OBTENER
	 * STOCK ZZONA IGUAL QUE STAND
	 * 
	 * @throws SQLException
	 * 
	 */

	public int insertarVenta(Venta ventaNueva) throws SQLException {
		String sql = "INSERT INTO venta (Fecha, Monto, tipo_pago, EMPLEADO_idEMPLEADO, stock_STAND_idStand, stock_STAND_ZONA_idzona, stock_JUGUETE_idJuguete) VALUES (CURDATE(),?,?,?,?,?,?)";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql, Statement.RETURN_GENERATED_KEYS)) {
			ps.setDouble(1, ventaNueva.getMontoTotal());
			ps.setString(2, ventaNueva.getTipoPago().name());
			ps.setInt(3, ventaNueva.getIdEmpleado().getIdEmpleado());
			ps.setInt(4, ventaNueva.getIdStand().getIdStand());
			ps.setInt(5, ventaNueva.getIdZonaStand().getIdZona());
			ps.setInt(6, ventaNueva.getIdJuguete().getIdJuguete());

			int filas = ps.executeUpdate();
			return filas;
		}
	}

	public Venta seleccionarVentaPorID(int idVenta) throws SQLException {
		String sql = "SELECT * FROM ventas where idVenta = ?";
		try (Connection conexion = DataBaseConnection.getConnection();
				PreparedStatement ps = conexion.prepareStatement(sql);) {
			ps.setInt(1, idVenta);
			ResultSet rs = ps.executeQuery();
			while (rs.next()) {
				return new Venta(rs.getInt("idventa"), rs.getDouble("Monto"), rs.getInt("stock_STAND_idStand"),
						rs.getInt("stock_STAND_ZONA_idzona"), rs.getInt("stock_JUGUETE_idJuguete"));
			}
		}
		return null;
	}

	public void listarVentas() throws SQLException {
		String sql = "SELECT * FROM venta";
		try (Connection conexion = DataBaseConnection.getConnection(); Statement st = conexion.createStatement()) {
			ResultSet rs = st.executeQuery(sql);
			while (rs.next()) {
				Date fecha = rs.getDate("Fecha"); // obtiene la fecha de la columna

				System.out.printf(
						"Id Venta: %d\n" + "Fecha: %s\n" + "Monto: %.2f\n" + "Tipo de pago: %s\n"
								+ "ID del empleado responsable: %d\n" + "ID del stand: %d\n" + "ID de la zona: %d\n"
								+ "ID del Juguete que compró: %d\n\n",
						rs.getInt("idVenta"), fecha, // imprime la fecha
						rs.getDouble("Monto"), rs.getString("tipo_pago"), rs.getInt("EMPLEADO_idEMPLEADO"),
						rs.getInt("stock_STAND_idStand"), rs.getInt("stock_STAND_ZONA_idzona"),
						rs.getInt("stock_JUGUETE_idJuguete"));
			}
		}
	}

	public int insertarCambio(Cambio cambioNuevo) throws SQLException {
	    String sql = "INSERT INTO cambio " +
	                 "(motivo, fecha, STOCK_STAND_idStand_Original, STOCK_STAND_ZONA_idzona_Original, STOCK_JUGUETE_idJuguete_Original, " +
	                 "STOCK_STAND_idStand_Nuevo, STOCK_STAND_ZONA_idzona_Nuevo, STOCK_JUGUETE_idJuguete_Nuevo, EMPLEADO_idEMPLEADO) " +
	                 "VALUES (?, CURDATE(), ?, ?, ?, ?, ?, ?, ?)";

	    try (Connection conexion = DataBaseConnection.getConnection();
	         PreparedStatement ps = conexion.prepareStatement(sql)) {

	        ps.setString(1, cambioNuevo.getMotivo());
	        ps.setInt(2, cambioNuevo.getStandOriginal().getIdStand());
	        ps.setInt(3, cambioNuevo.getZonaOriginal().getIdZona());
	        ps.setInt(4, cambioNuevo.getJugueteOriginal().getIdJuguete());
	        ps.setInt(5, cambioNuevo.getStandNuevo().getIdStand());
	        ps.setInt(6, cambioNuevo.getZonaNueva().getIdZona());
	        ps.setInt(7, cambioNuevo.getJugueteNuevo().getIdJuguete());
	        ps.setInt(8, cambioNuevo.getEmpleado().getIdEmpleado());

	        int filas = ps.executeUpdate();
	        return filas;
	    }
	}

}
