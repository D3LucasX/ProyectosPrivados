package DAO;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.Statement;
import java.util.ArrayList;

import DataBase.DataBaseConnection;
import model.Juguete;
import model.Stand;
import model.Zona;

public class StandDAO {

	public ArrayList<Stand> listarTodos() {
		ArrayList<Stand> lista = new ArrayList<>();
		String sql = "SELECT * FROM stand";

		try (Connection conexion = DataBaseConnection.getConnection();
				Statement st = conexion.createStatement();
				ResultSet rs = st.executeQuery(sql)) {

			while (rs.next()) {
				lista.add(new Stand(rs.getInt("idStand"), rs.getString("Nombre"), rs.getInt("ZONA_idzona")));
			}
		}
		return lista;
	}
}
