	public Venta crearVenta(Scanner entrada, EmpleadoService serviceE) throws SQLException {
		boolean valido = false;
		Empleado vendedor = null;
		do {
			vendedor = serviceE.seleccionarEmpleado(entrada);
			if (vendedor != null) {
				valido = true;
			}else {
				System.err.println("No se ha encontrado dicho vendedor, o algo salio mal.");
			}
		}while(!valido);
		
		
	}
